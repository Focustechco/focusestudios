# ===================================================================
# Focus Publisher - Configurações de Ambiente (.env)
# ===================================================================

# Modo de Operação: DEMO, DIRECT_POST, MANUAL_STUDIO, UPLOAD
# Inicia por padrão em DEMO (sem risco de publicações reais)
OPERATION_MODE=DEMO

# Identidade & Fuso Horário
APP_NAME="Focus Publisher"
APP_ENV=development
DEBUG=false
TIMEZONE=America/Fortaleza

# Segredos da Aplicação & Criptografia de Tokens (Fernet 32-bytes base64)
# Para gerar uma nova chave: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET=sua_chave_secreta_de_sessao_aqui
TOKEN_ENCRYPTION_KEY=sua_chave_fernet_32_bytes_base64_aqui

# Banco de Dados & Cache / Broker
POSTGRES_USER=focus
POSTGRES_PASSWORD=sua_senha_postgres_forte
POSTGRES_DB=focus_publisher
DATABASE_URL=postgresql+psycopg2://focus:sua_senha_postgres_forte@postgres:5432/focus_publisher
REDIS_URL=redis://redis:6379/0

# Metas do Calendário Interno
DAILY_POST_TARGET=10
OVERDUE_TOLERANCE_MINUTES=15

# Google Drive API
GOOGLE_DRIVE_FOLDER_ID=seu_google_drive_folder_id_aqui
DRIVE_INCLUDE_SUBFOLDERS=false
DRIVE_SYNC_INTERVAL_MINUTES=15
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_REDIRECT_URI=https://seu-dominio.com/connections/google/callback
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google_service_account.json

# TikTok Content Posting API (Direct Post)
TIKTOK_CLIENT_KEY=sua_tiktok_client_key_aqui
TIKTOK_CLIENT_SECRET=seu_tiktok_client_secret_aqui
TIKTOK_REDIRECT_URI=https://seu-dominio.com/connections/tiktok/callback

# Inteligência Artificial para Legendas (Opcional - Desativada por padrão)
AI_CAPTION_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=sua_api_key_opcional_aqui

# Usuário Administrativo Inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_senha_forte
